#!/bin/sh
#
# commit-msg — enforce the commit style from CLAUDE.md section 7.
#
# Rules checked against the subject (first line):
#   1. Not empty.
#   2. At most 72 characters.
#   3. Starts with a capital letter.
#   4. Ends with a period.
#   5. Carries no conventional prefix ("feat:", "fix:", "chore:", ...).
#
# Git runs this from the repository root and passes the path to the
# temporary commit-message file as $1.

set -e

msg_file="$1"
subject=$(head -n 1 "$msg_file")
exit_code=0

fail() {
    echo "[husky] commit-msg: $1"
    exit_code=1
}

if [ -z "$subject" ]; then
    fail "the subject line is empty."
fi

if [ "${#subject}" -gt 72 ]; then
    fail "the subject is ${#subject} characters; keep it under 72."
fi

case "$subject" in
    [A-Z]*) ;;
    *) fail "the subject must start with a capital letter: '$subject'" ;;
esac

case "$subject" in
    *.) ;;
    *) fail "the subject must end with a period: '$subject'" ;;
esac

# Conventional-commit prefixes are banned by CLAUDE.md section 7.2.
case "$subject" in
    *:*)
        prefix=${subject%%:*}
        case "$prefix" in
            *" "*) ;;
            *) fail "drop the '$prefix:' prefix — subject lines read as plain sentences." ;;
        esac
        ;;
esac

exit "$exit_code"
