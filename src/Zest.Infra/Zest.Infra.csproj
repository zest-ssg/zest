<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- C# compiles without ordering constraints; sources under Configuration/
       and Services/ are picked up by the SDK default glob, so no explicit
       <Compile> list is required. -->
  <ItemGroup>
    <ProjectReference Include="..\Zest.Engine\Zest.Engine.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zest.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
