<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <!-- F# compiles top-down: a file may only reference symbols declared in
       earlier files, so the list below is ordered by dependency. -->
  <ItemGroup>
    <!-- Core context (no project dependencies) -->
    <Compile Include="ZestContext.fs" />

    <!-- HTML DSL + component builders (depend on Context) -->
    <Compile Include="DslHtml.fs" />
    <Compile Include="DslComponents.fs" />

    <!-- Standalone utility helpers -->
    <Compile Include="StringProcessor.fs" />
    <Compile Include="DateFormatter.fs" />
    <Compile Include="SequenceProcessor.fs" />

    <!-- Sugar + compound builders (depend on Dsl, Context, helpers) -->
    <Compile Include="DslSugar.fs" />
    <Compile Include="ContentBuilder.fs" />

    <!-- CSS DSL; validator/scoper feed DslStyle (depend on Dsl) -->
    <Compile Include="DslCss.fs" />
    <Compile Include="StyleValidator.fs" />
    <Compile Include="StyleScoper.fs" />
    <Compile Include="DslStyle.fs" />

    <!-- Content safety guard -->
    <Compile Include="ContentGuard.fs" />

    <!-- Collection/page-query APIs (depend on Context) -->
    <Compile Include="DslCollections.fs" />

    <!-- Higher-level DSLs (DslMigration opens DslHelpers) -->
    <Compile Include="DslHelpers.fs" />
    <Compile Include="DslSeo.fs" />
    <Compile Include="DslXml.fs" />
    <Compile Include="DslMigration.fs" />
    <Compile Include="DslCompat.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed so the DSL can expose a native `md` helper that renders
         Markdown to HTML (Zest.Engine.Html.MarkdownEngine.toHtml). The FSI
         isolation copies only Zest.Dsl.dll, so Zest.Engine.dll resolves from
         the app base directory at runtime — no second FSharp.Core is loaded. -->
    <ProjectReference Include="..\Zest.Engine\Zest.Engine.fsproj" />
  </ItemGroup>
</Project>
