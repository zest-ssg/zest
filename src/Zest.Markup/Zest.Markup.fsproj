<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <!-- F# compiles top-down: a file may only reference symbols declared in
       earlier files, so the list below is ordered by dependency. -->
  <ItemGroup>
    <!-- Dsl: build context, the foundational DSL primitives, and sugar -->
    <Compile Include="Dsl/Context.fs" />
    <Compile Include="Dsl/Dsl.fs" />
    <Compile Include="Dsl/DslSugar.fs" />
    <Compile Include="Dsl/ContentGuard.fs" />

    <!-- Primitives: generic string/date/sequence/value helpers -->
    <Compile Include="Primitives/Text.fs" />
    <Compile Include="Primitives/Dates.fs" />
    <Compile Include="Primitives/Sequences.fs" />
    <Compile Include="Primitives/Values.fs" />

    <!-- Css: the ZCSS stylesheet DSL, validation, scoping, and the inline style API -->
    <Compile Include="Css/Stylesheet.fs" />
    <Compile Include="Css/Validator.fs" />
    <Compile Include="Css/Scoper.fs" />
    <Compile Include="Css/InlineStyle.fs" />

    <!-- Component: high-level component builders (Compound opens DslSugar) -->
    <Compile Include="Component/Components.fs" />
    <Compile Include="Component/Compound.fs" />

    <!-- Query: page query and collection APIs -->
    <Compile Include="Query/Collections.fs" />

    <!-- Metadata: SEO tags and RSS/Atom/Sitemap feeds -->
    <Compile Include="Metadata/Seo.fs" />
    <Compile Include="Metadata/Feeds.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared primitives (slugs, prose metrics, date formatting) that the
         engine also uses. Zest.Core lives in libs/ and has no dependencies of
         its own, so it adds nothing to the FSI isolation copy beyond one
         assembly. -->
    <ProjectReference Include="..\..\libs\Zest.Core\Zest.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed so the DSL can expose a native `md` helper that renders
         Markdown to HTML (Zest.Compiler.Html.Markdown.toHtml). The FSI
         isolation copies only Zest.Markup.dll, so Zest.Compiler.dll resolves from
         the app base directory at runtime — no second FSharp.Core is loaded. -->
    <ProjectReference Include="..\Zest.Compiler\Zest.Compiler.fsproj" />
  </ItemGroup>
</Project>
