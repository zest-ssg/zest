<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <!-- F# compiles top-down: a file may only reference symbols declared in
       earlier files, so the list below is ordered by dependency. -->
  <ItemGroup>
    <!-- Core: build context, the foundational DSL primitives, and sugar -->
    <Compile Include="Core/ZestContext.fs" />
    <Compile Include="Core/Dsl.fs" />
    <Compile Include="Core/DslSugar.fs" />
    <Compile Include="Core/ContentGuard.fs" />

    <!-- Utility: generic string/date/sequence/config helpers -->
    <Compile Include="Utility/StringHelper.fs" />
    <Compile Include="Utility/DateHelper.fs" />
    <Compile Include="Utility/SequenceHelper.fs" />
    <Compile Include="Utility/DslHelpers.fs" />

    <!-- Style: the ZCSS DSL, validation, scoping, and the inline style API -->
    <Compile Include="Style/DslCss.fs" />
    <Compile Include="Style/CssValidator.fs" />
    <Compile Include="Style/CssScoper.fs" />
    <Compile Include="Style/DslStyle.fs" />

    <!-- Html: high-level component builders (CompoundBuilder opens DslSugar) -->
    <Compile Include="Html/DslComponents.fs" />
    <Compile Include="Html/CompoundBuilder.fs" />

    <!-- Data: page query and collection APIs -->
    <Compile Include="Data/DslCollections.fs" />

    <!-- Metadata: SEO tags and RSS/Atom/Sitemap feeds -->
    <Compile Include="Metadata/DslSeo.fs" />
    <Compile Include="Metadata/DslXml.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared primitives (slugs, prose metrics, date formatting) that the
         engine also uses. Zest.Core lives in libs/ and has no dependencies of
         its own, so it adds nothing to the FSI isolation copy beyond one
         assembly. -->
    <ProjectReference Include="..\..\libs\Zest.Core\Zest.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed so the DSL can expose a native `md` helper that renders
         Markdown to HTML (Zest.Compiler.Html.MarkdownEngine.toHtml). The FSI
         isolation copies only Zest.Markup.dll, so Zest.Compiler.dll resolves from
         the app base directory at runtime — no second FSharp.Core is loaded. -->
    <ProjectReference Include="..\Zest.Compiler\Zest.Compiler.fsproj" />
  </ItemGroup>
</Project>
