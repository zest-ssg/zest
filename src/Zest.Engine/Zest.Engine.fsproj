<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Domain types (ordered by dependency) -->
    <Compile Include="Domain/FileExtensions.fs" />
    <Compile Include="Domain/HtmlNodes.fs" />
    <Compile Include="Domain/ContentPage.fs" />
    <Compile Include="Domain/PageGroup.fs" />
    <Compile Include="Domain/SiteConfig.fs" />
    <Compile Include="Domain/BuildResult.fs" />
    <Compile Include="Domain/ScriptContext.fs" />
    <Compile Include="Domain/ContentMeta.fs" />

    <!-- Theme system -->
    <Compile Include="Theme/ThemeResolver.fs" />
    <Compile Include="Theme/ThemeConfigLoader.fs" />

    <!-- ZCSS pipeline (layered: Syntax → Evaluation → Parsing → Builtins → Compilation → Tooling) -->
    <Compile Include="Zcss/Syntax/ZcssAst.fs" />
    <Compile Include="Zcss/Syntax/CoreParser.fs" />
    <Compile Include="Zcss/Evaluation/BuiltinFunctions.fs" />
    <Compile Include="Zcss/Evaluation/ColorPipeline.fs" />
    <Compile Include="Zcss/Evaluation/MathEvaluator.fs" />
    <Compile Include="Zcss/Evaluation/Evaluator.fs" />
    <Compile Include="Zcss/Parsing/BraceParser.fs" />
    <Compile Include="Zcss/Parsing/IndentParser.fs" />
    <Compile Include="Zcss/Parsing/Parser.fs" />
    <Compile Include="Zcss/Builtins/BuiltinStyles.fs" />
    <Compile Include="Zcss/Builtins/ZcssHelpers.fs" />
    <Compile Include="Zcss/Builtins/Modules.fs" />
    <Compile Include="Zcss/Compilation/ZcssCache.fs" />
    <Compile Include="Zcss/Compilation/Compiler.fs" />
    <Compile Include="Zcss/Compilation/Processor.fs" />
    <Compile Include="Zcss/Tooling/Completions.fs" />
    <Compile Include="Zcss/Tooling/TypeChecker.fs" />

    <!-- Routing -->
    <Compile Include="Routing/PermalinkRouter.fs" />

    <!-- Parsing -->
    <Compile Include="Parsing/MetaParser.fs" />

    <!-- Template engines -->
    <Compile Include="Template/ITemplateEngine.fs" />

    <!-- Zealucks engine (dependency order: types → tokenizer → compiler → evaluator → blocks → renderer → engine) -->
    <Compile Include="Template/ZealucksEngine/ZealucksTypes.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksTokenizer.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksCompiler.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksEvaluator.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksBlocks.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksRenderer.fs" />
    <Compile Include="Template/ZealucksEngine/ZealucksEntry.fs" />

    <Compile Include="Template/TemplateManager.fs" />

    <!-- HTML components -->
    <Compile Include="Html/HtmlElements.fs" />
    <Compile Include="Html/HtmlAttributes.fs" />
    <Compile Include="Html/HtmlModifiers.fs" />
    <Compile Include="Html/HtmlComponents.fs" />
    <Compile Include="Html/HtmlRenderer.fs" />
    <Compile Include="Html/HtmlFormatter.fs" />
    <Compile Include="Html/MarkdownEngine.fs" />
    <Compile Include="Html/PageBuilder.fs" />
    <Compile Include="Html/TemplateDsl.fs" />
    <Compile Include="Html/HtmlHelpers.fs" />
    <Compile Include="Html/ShortcodeRegistry.fs" />
    <Compile Include="Html/PageCollections.fs" />
    <Compile Include="Html/PagedResult.fs" />
    <Compile Include="Html/TemplateData.fs" />

    <!-- Static resources (no project dependencies; consumed by Scripting/Build) -->
    <Compile Include="Resources/ZestPjax.fs" />

    <!-- I18n locale system (consumed by Scripting filters and the Build pipeline) -->
    <Compile Include="I18n/LocaleLoader.fs" />

    <!-- Scripting (depends on Domain, Routing, Parsing, Template, Html, Resources) -->
    <Compile Include="Scripting/FsiSession.fs" />
    <Compile Include="Scripting/InitEngine.fs" />
    <Compile Include="Scripting/PageQuery.fs" />
    <Compile Include="Scripting/FilterRegistry.fs" />
    <Compile Include="Scripting/ScriptDiscovery.fs" />
    <Compile Include="Scripting/ScriptRunner.fs" />
    <Compile Include="Scripting/ScriptEvaluator.fs" />

    <!-- Build pipeline (depends on everything above) -->
    <Compile Include="Build/PathResolver.fs" />
    <Compile Include="Build/BuildProgress.fs" />
    <Compile Include="Build/BuildCache.fs" />
    <Compile Include="Build/AtomicFile.fs" />
    <Compile Include="Build/IncrementalBuilder.fs" />
    <Compile Include="Build/BuildScheduler.fs" />
    <Compile Include="Build/BuildData.fs" />
    <Compile Include="Build/BuildAssets.fs" />
    <Compile Include="Build/LayoutEngine.fs" />
    <Compile Include="Build/BuildLayout.fs" />
    <Compile Include="Build/ContentPipeline.fs" />
    <Compile Include="Build/TaxonomyGenerator.fs" />
    <Compile Include="Build/PaginationGenerator.fs" />
    <Compile Include="Build/BuildEngine.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zest.Core holds the primitives shared with Zest.Dsl (slugs, prose
         metrics, date formatting). Keeping them outside the engine lets the
         DSL depend on them without depending on the whole build pipeline. -->
    <ProjectReference Include="..\..\libs\Zest.Core\Zest.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
