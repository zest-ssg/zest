/* ---------------------------------------------------------------------------
   Listings — home page entry list, pagination, tag index and archive.

   Markup for the entry list and pagination comes from content/index.zest.fsx; the
   tag index and archive are generated by the engine and by
   content/archive.zest.fsx.
   --------------------------------------------------------------------------- */

.list-intro [
  max-width: 32rem;
  margin: 0 auto 1.5rem;
  text-align: center;
  font-style: italic;
  color: muted;
]

.post-list [
  list-style: none;
  padding-left: 0;
  counter-reset: entry;
]

.post-list__item [
  counter-increment: entry;
  padding: 1rem 0;
  border-top: 1px solid rule;
]

.post-list__item:first-child [
  border-top: 0;
  padding-top: 0;
]

.post-list__title [
  font-size: 1.125rem;
  margin-top: 0;
]

.post-list__title:before [
  content: '[' counter(entry) ']';
  margin-right: 0.5rem;
  color: muted;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
]

.post-list__meta [
  margin-top: 0.25rem;
  font-size: 0.8125rem;
  color: muted;
]

.post-list__excerpt [
  margin-top: 0.5rem;
  color: muted;
]

.pagination [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-top: 2.5rem;
  padding-top: 1rem;
  border-top: 1px solid ink;
  font-size: 0.875rem;
]

.pagination__step--off [
  color: rule;
]

.pagination__folio [
  color: muted;
  font-style: italic;
]

.terms-intro [
  color: muted;
  font-style: italic;
]

.terms [
  list-style: none;
  padding-left: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
]

.archive__year [
  margin-top: 2rem;
]

.archive__year:first-child [
  margin-top: 0;
]
