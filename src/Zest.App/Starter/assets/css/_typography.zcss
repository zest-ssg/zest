/* ---------------------------------------------------------------------------
   Typography — reset, document typography, links, media, quotes, code and
   booktabs tables: the type every partial below builds on.
   --------------------------------------------------------------------------- */

*, *:before, *:after [
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
]

body [
  background: paper;
  color: ink;
  font-family: font-serif;
  font-size: 1rem;
  line-height: 1.625;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
]

h1, h2, h3, h4, h5, h6 [
  line-height: 1.25;
  letter-spacing: -0.01em;
  font-weight: 600;
]

h1 [ font-size: 1.875rem; ]
h2 [ font-size: 1.5rem; ]
h3 [ font-size: 1.25rem; ]

p, ul, ol, blockquote, pre, table, figure [
  margin-top: 1rem;
]

ul, ol [
  padding-left: 1.5rem;
]

a [
  color: link;
  text-decoration: none;
]

a:hover [
  text-decoration: underline;
  text-underline-offset: 2px;
]

:focus-visible [
  outline: 2px solid ink;
  outline-offset: 2px;
]

img, svg [
  display: block;
  max-width: 100%;
]

img [
  height: auto;
]

blockquote [
  background: surface;
  padding: 1rem 1.25rem;
  font-style: italic;
  color: muted;
]

code, pre [
  font-family: font-mono;
  background: surface;
]

code [
  padding: 0.1rem 0.3rem;
  font-size: 0.9em;
]

pre [
  padding: 1rem;
  overflow-x: auto;
  font-size: 0.9rem;
  line-height: 1.5;
]

pre code [
  background: transparent;
  padding: 0;
]

hr [
  border-top: 1px solid rule;
  margin-top: 2rem;
]

/* Tables are booktabs: two heavy rules and one thin rule under the header.
   No vertical lines, no zebra rows, no fill. */
table [
  width: 100%;
  border-collapse: collapse;
  border-top: 2px solid ink;
  border-bottom: 2px solid ink;
]

thead th [
  border-bottom: 1px solid ink;
]

th, td [
  padding: 0.5rem 0.75rem;
  text-align: left;
]

.table-caption [
  margin-top: 1.5rem;
  margin-bottom: 0.25rem;
  font-size: 0.875rem;
]
