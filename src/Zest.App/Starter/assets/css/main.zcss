/* ---------------------------------------------------------------------------
   main.zcss — the only stylesheet the site links, and nothing more than an
   index of the partials that make up the design.

   `@use` inlines an imported file at this point in the cascade, the way F#
   `open` brings a module's names into scope, so:

     - the order below IS the cascade order, and
     - the tokens imported first are visible to every partial after them
       (`paper`, `ink`, `measure`, ... need no re-declaration).

   The partials sit next to this file and start with an underscore. The build
   compiles every .zcss under assets/ into a stylesheet of the same name, with
   one exception: `_name.zcss` is a fragment, imported rather than published,
   so no `_name.css` is ever written. The only stylesheet the browser downloads
   is main.css.

   To add a partial: create assets/css/_name.zcss, add its `@use` line below in
   cascade order, and register the file in src/Zest.App/Zest.App.csproj so that
   `zest init` copies it into new sites.
   --------------------------------------------------------------------------- */

@use "_tokens.zcss"
@use "_base.zcss"
@use "_shell.zcss"
@use "_paper.zcss"
@use "_environments.zcss"
@use "_listings.zcss"
@use "_controls.zcss"
@use "_responsive.zcss"
