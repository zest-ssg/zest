/* ---------------------------------------------------------------------------
   The article block — the `paper__*` elements every page body is built from:
   centred title, subtitle, and the numbered section body.

   The counters live on .paper__body, so the numbering is per document and
   never leaks between pages. Markup comes from _layouts/post.zest.fsx and
   _layouts/default.zest.fsx; the `paper` prefix is the class namespace, not
   the name of this file.
   --------------------------------------------------------------------------- */

.paper__head [
  text-align: center;
  margin-bottom: 3rem;
]

.paper__title [
  font-size: 2.25rem;
  line-height: 1.15;
]

.paper__subtitle [
  margin-top: 0.75rem;
  font-size: 0.9375rem;
  font-style: italic;
  color: muted;
]

.paper__author [
  margin-top: 0.75rem;
  font-size: 0.875rem;
]

.paper__date [
  margin-top: 0.25rem;
  font-size: 0.875rem;
  font-style: italic;
  color: muted;
]

.paper__body [
  word-wrap: break-word;
  counter-reset: section;
]

.paper__body h2 [
  margin-top: 2.25rem;
  counter-increment: section;
  counter-reset: subsection;
]

.paper__body h2:before [
  content: counter(section);
  margin-right: 0.75rem;
  font-variant-numeric: tabular-nums;
]

.paper__body h3 [
  margin-top: 1.75rem;
  counter-increment: subsection;
]

.paper__body h3:before [
  content: counter(section) '.' counter(subsection);
  margin-right: 0.75rem;
  font-variant-numeric: tabular-nums;
]

.paper__body h4 [
  margin-top: 1.5rem;
]

.paper__footer [
  margin-top: 3rem;
  padding-top: 1rem;
  border-top: 1px solid rule;
  font-size: 0.875rem;
]

.paper__tags-label [
  margin-right: 0.5rem;
  color: muted;
]

.paper__tags a + a:before [
  content: ', ';
  color: ink;
]

.paper__nav [
  margin-top: 0.75rem;
  color: muted;
]
