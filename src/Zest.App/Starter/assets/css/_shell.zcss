/* ---------------------------------------------------------------------------
   Page shell — header, navigation, main column and footer.

   The markup these class names target is produced by _layouts/shell.zest.fsx.
   --------------------------------------------------------------------------- */

.page [
  display: flex;
  flex-direction: column;
  min-height: 100vh;
]

.site-header [
  width: 100%;
  max-width: measure;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 1rem;
  border-bottom: 1px solid rule;
]

.site-header__inner [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
]

.site-header__title [
  color: ink;
  font-size: 1rem;
  letter-spacing: 0.02em;
]

.site-header__title:hover [
  text-decoration: none;
]

.site-nav [
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.875rem;
]

.page__main [
  flex: 1;
  width: 100%;
  max-width: measure;
  margin: 0 auto;
  padding: 3rem 1.5rem 4rem;
]

.site-footer [
  width: 100%;
  max-width: measure;
  margin: 0 auto;
  padding: 1.25rem 1.5rem 2.5rem;
  border-top: 1px solid rule;
  color: muted;
  font-size: 0.8125rem;
]

.site-footer__inner [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
]

.site-footer__meta [
  margin: 0;
]
