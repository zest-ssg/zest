<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- .NET Tool packaging
         Installed via:  dotnet tool install -g zest
         Invoked via:    zest <command>
         PackAsTool places the output under the tool manifest layout
         so `dotnet tool install` works against the produced .nupkg.
         ToolCommandName=zest keeps the CLI command name short.
         PackageId=zest matches the .NET tool naming convention
         (lowercase, like dotnet-ef / powershell / dotnet-outdated). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zest</ToolCommandName>
    <PackageId>zest</PackageId>
    <IsPackable>true</IsPackable>

    <!-- Framework-dependent deployment (FSI needs assemblies on disk).
         No RID is set so the tool is platform-neutral and runs on any
         .NET 10 runtime (win/linux/osx). The previous win-x64 hard-coding
         blocked `dotnet tool install` on non-Windows hosts. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AssemblyName>zest</AssemblyName>
    <DebugType>embedded</DebugType>

    <!-- Publish trimming: exclude unused files -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- App icon -->
    <ApplicationIcon>..\..\zest.ico</ApplicationIcon>

    <!-- Pack README + icon into the .nupkg so nuget.org shows them.
         The files live at repo root; PackFolderInclude keeps them
         at the package root for NuGet's metadata conventions. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>zest.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zest.Compiler\Zest.Compiler.fsproj" />
    <ProjectReference Include="..\Zest.Markup\Zest.Markup.fsproj" />
  </ItemGroup>

  <!-- CLI branding and help text live in .config/zest/, split by concern:
       meta.toml (name, version, tagline) and help.toml (help copy). Both are
       embedded as resources so the tool works immediately after
       `dotnet tool install` without needing to locate them on disk.
       HelpRenderer merges them and falls back to the files on disk during
       local development. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.config\zest\meta.toml">
      <LogicalName>zest.meta.toml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\.config\zest\help.toml">
      <LogicalName>zest.help.toml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Bundled `zest init` starter site. Every file is listed explicitly so the
       shipped manifest is self-documenting; LogicalName preserves the relative
       path (using backslashes) so InitCommand can reconstruct file paths at
       runtime. `Starters` is the scaffold copied out by init; it is not the
       runtime template engine (which lives in Zest.Compiler/Template). -->
  <ItemGroup>
    <None Remove="Starters\**\*" />
    <EmbeddedResource Include="Starters\_config.toml" LogicalName="Zest.App.Starters._config.toml" />
    <EmbeddedResource Include="Starters\README.md" LogicalName="Zest.App.Starters.README.md" />
    <EmbeddedResource Include="Starters\content\index.md" LogicalName="Zest.App.Starters.content\index.md" />
    <EmbeddedResource Include="Starters\content\rss.zest.fsx" LogicalName="Zest.App.Starters.content\rss.zest.fsx" />
    <EmbeddedResource Include="Starters\content\atom.zest.fsx" LogicalName="Zest.App.Starters.content\atom.zest.fsx" />
    <EmbeddedResource Include="Starters\content\sitemap.zest.fsx" LogicalName="Zest.App.Starters.content\sitemap.zest.fsx" />
    <EmbeddedResource Include="Starters\_layouts\post.zlk" LogicalName="Zest.App.Starters._layouts\post.zlk" />
    <EmbeddedResource Include="Starters\_includes\head.zlk" LogicalName="Zest.App.Starters._includes\head.zlk" />
    <EmbeddedResource Include="Starters\_includes\header.zlk" LogicalName="Zest.App.Starters._includes\header.zlk" />
    <EmbeddedResource Include="Starters\assets\css\main.zcss" LogicalName="Zest.App.Starters.assets\css\main.zcss" />
  </ItemGroup>

  <!-- Package icon + README at the nupkg root (NuGet metadata convention). -->
  <ItemGroup>
    <None Include="..\..\zest.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude unused files from publish output -->
  <ItemGroup>
    <!-- Remove satellite resource assemblies (empty locale folders) -->
    <SatelliteAssemblies Remove="@(SatelliteAssemblies)" />
    <!-- Exclude XML documentation files -->
    <None Remove="**\*.xml" />
    <None Remove="**\*.pdb" />
    <!-- Exclude source files from publish -->
    <None Remove="**\*.fs" />
    <None Remove="**\*.fsi" />
    <None Remove="**\*.fsproj" />
    <None Remove="**\*.cs" />
    <None Remove="**\*.csproj" />
  </ItemGroup>

</Project>
