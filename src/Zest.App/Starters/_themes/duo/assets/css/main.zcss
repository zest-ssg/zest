// main.zcss — duo-inspired Zest blog theme
//
// Inspired by the Eleventy Duo theme (yinkakun/eleventy-duo),
// ported to ZCSS. Clean typography, restrained colour palette,
// and a fixed reading measure that centres content gracefully.
//
// ── Authoring conventions ───────────────────────────
// 1. Root font-size must be absolute (px or %), never `r`/`rem`,
//    since rem is relative to this very value.
// 2. Design tokens declared with `let` for consistency.
// 3. The `r` unit shorthand compiles to `rem`.

// ── Design tokens ──────────────────────────────────
let accent      = #0074d9          // primary accent (links, code)
let heading     = rgb(6, 6, 6)     // headings / titles
let bodyColor   = rgb(41, 41, 41)  // body text
let muted       = rgb(117, 117, 117) // secondary/meta text
let borderColor = rgb(230, 230, 230) // hairline borders
let codeBg      = rgba(41, 41, 41, 0.05)  // inline code background
let bg          = #fffffe          // page background
let measure     = 48.75r           // max-width reading column (780px)

// ── Reset & base ───────────────────────────────────
*, *:before, *:after [
  box-sizing = border-box
  margin = 0
  padding = 0
]

html [
  font-size = 17px
  scroll-behavior = smooth
  height = 100%
  -webkit-text-size-adjust = 100%
  overflow-y = scroll
  scrollbar-gutter = stable
]

body [
  margin = 0
  background-color = bg
  color = bodyColor
  font-family = -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif
  font-size = 1.125r
  line-height = 1.54
  text-rendering = optimizeLegibility
  -webkit-font-smoothing = antialiased
  min-height = 100%
]

// ── Layout: sticky footer via flex ─────────────────
// Body is a flex column; main flexes to fill available space.
.layout-wrapper [
  display = flex
  flex-direction = column
  min-height = 100vh
]

// ── Fixed-width container ──────────────────────────
// All sections share the same max-width for visual consistency.
.container [
  width = 100%
  max-width = measure
  margin = 0 auto
  padding = 0 1r
]

// ── Header ─────────────────────────────────────────
// Border-bottom is placed inside the content area,
// not across the full viewport, matching the duo approach.
.site-header [
  margin-bottom = 4r
]

.site-header__inner [
  display = flex
  flex-wrap = wrap
  justify-content = space-between
  align-items = center
  max-width = measure
  margin = 0 auto
  padding = 1r
  border-bottom = 1px solid borderColor
]

.site-header__brand [
  font-size = 1.2r
  font-weight = 600
  color = heading
  text-decoration = none
  &:hover [
    color = accent
  ]
]

.site-nav [
  display = flex
  gap = 2r
  list-style = none
  font-size = 1r
  padding = 0.5r 0
]

.site-nav__link [
  color = muted
  text-decoration = none
  &:hover [
    color = heading
  ]
]

// ── Main ───────────────────────────────────────────
.site-main [
  flex = 1
  padding-bottom = 4r
]

// ── Links ──────────────────────────────────────────
a [
  color = accent
  text-decoration = underline
  transition = color 200ms linear
  &:hover [
    color = darken(accent, 15%)
  ]
]

// Links inside prose content should be underlined;
// navigation links are not.
nav a, .site-header__brand, .site-footer a [
  text-decoration = none
]

// ── Images ─────────────────────────────────────────
img, video [
  display = block
  max-width = 100%
  height = auto
]

// ── Typography ─────────────────────────────────────
h1, h2, h3, h4, h5, h6 [
  line-height = 1.3
  font-weight = 400
  color = heading
]

h1 [ font-size = 2.25r ]
h2 [ font-size = 1.875r ]
h3 [ font-size = 1.5r ]
h4 [ font-size = 1.25r ]
h5 [ font-size = 1.125r ]

* + h1, * + h2 [ margin-top = 5r ]
* + h3, * + h4, * + h5 [ margin-top = 3r ]
* + p [ margin-top = 2r ]
h2 + p, h3 + p, h4 + p [ margin-top = 1r ]

p [
  font-size = 1.125r
  line-height = 1.7
]

// ── Code ───────────────────────────────────────────
// Inline code: subtle highlight, accent colour.
code, kbd [
  font-family = ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size = 0.95em
  background = codeBg
  color = accent
  padding = 1px 6px
  margin = 0 2px
  border-radius = 3px
  font-feature-settings = normal
]

// Block code: full-width background, scrollable.
pre [
  overflow-x = auto
  max-width = 100%
  font-family = ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size = 0.95r
  background = codeBg
  border = 1px solid borderColor
  padding = 1r
  margin-top = 2r
  margin-bottom = 2r
  white-space = pre-wrap
  tab-size = 2
  scrollbar-width = thin
  scrollbar-color = muted
]

pre code [
  background = transparent
  padding = 0
  margin = 0
  color = inherit
  font-size = inherit
]

// ── Blockquote ─────────────────────────────────────
blockquote [
  margin-top = 2r
  margin-bottom = 2r
  padding-left = 1r
  border-left = 3px solid accent
  color = rgba(41, 41, 41, 0.8)
  font-style = italic
]

// ── Lists ──────────────────────────────────────────
ol [ list-style-position = inside ]
ol ol [ list-style-type = lower-alpha ]
ul [
  list-style-type = square
  list-style-position = inside
]

// ── Tables ─────────────────────────────────────────
table [
  border-collapse = collapse
  caption-side = bottom
  overflow-x = auto
  min-width = 100%
  border = 1px solid rgba(41, 41, 41, 0.2)
  margin-top = 2r
]

td, th [
  border = 1px solid rgba(41, 41, 41, 0.2)
  padding = 0.5r
  text-align = left
]

th [ font-weight = 500 ]

// ── Horizontal rule ────────────────────────────────
hr [
  width = 100%
  border = none
  background = rgba(41, 41, 41, 0.1)
  height = 1px
  margin-top = 2r
  margin-bottom = 2r
]

// ── Home: hero section ─────────────────────────────
.hero [
  display = flex
  flex-direction = column
]

.hero__title [
  font-size = 3r
  line-height = 1.1
  margin-bottom = 1r
  color = heading
]

.hero__lead [
  font-size = 1.5r
  color = rgba(41, 41, 41, 0.7)
  margin-top = 1r
  line-height = 1.5
]

// ── Post list ──────────────────────────────────────
// Each item separated by a hairline, clean and uncluttered.
.post-list [
  list-style = none
  margin = 0
  padding = 0
]

.post-list__item [
  padding = 1.25r 0
  border-bottom = 1px solid borderColor
  &:last-child [
    border-bottom = none
  ]
]

.post-list__title [
  margin = 0 0 0.25r
  font-size = 1.35r
  line-height = 1.3
  a [
    color = heading
    text-decoration = none
    &:hover [
      color = accent
    ]
  ]
]

.post-list__meta [
  font-size = 0.875r
  color = muted
  margin-top = 0.25r
]

.post-list__excerpt [
  margin-top = 0.5r
  color = rgba(41, 41, 41, 0.7)
  font-size = 1r
  line-height = 1.6
]

// ── Single post ────────────────────────────────────
.post [
  display = flex
  flex-direction = column
]

.post > * + * [ margin-top = 4r ]

.post__header [
  margin-bottom = 2r
]

.post__title [
  font-size = 2.25r
  line-height = 1.2
  color = heading
  margin-bottom = 0.5r
]

.post__meta [
  font-size = 0.9r
  color = muted
  opacity = 0.8
]

.post__tags [
  margin-left = 0.75r
  opacity = 0.8
]

.post__tag [
  color = muted
]

.post__body [
  word-wrap = break-word
  font-size = 1.05r
  font-family = Georgia, "Times New Roman", serif
  line-height = 1.8
]

.post__body a [
  text-decoration = underline
  color = accent
  &:hover [
    color = darken(accent, 10%)
  ]
]

// ── Post pagination (prev / next) ──────────────────
.post__pagination [
  margin-top = 3r
  display = flex
  justify-content = space-between
  align-items = center
  font-size = 0.95r
]

.post__pagination a [
  display = flex
  align-items = center
  gap = 0.5r
  text-decoration = none
  color = muted
  &:hover [
    color = accent
  ]
]

.post__pagination > *:only-child [
  margin-right = auto
  margin-left = auto
]

// ── Footer ─────────────────────────────────────────
.site-footer [
  padding-bottom = 4r
]

.site-footer__inner [
  display = flex
  flex-direction = column
  align-items = center
  max-width = measure
  margin = 0 auto
  padding = 1r
  border-top = 1px solid borderColor
  font-size = 1r
  gap = 2r
  padding-top = 2r
]

.site-footer__social [
  display = flex
  flex-wrap = wrap
  list-style = none
  gap = 2r
  text-transform = uppercase
  font-size = 0.875r
]

.site-footer__social a [
  color = muted
  &:hover [
    color = accent
  ]
]

.site-footer__copy [
  font-size = 0.875r
  color = muted
  text-align = center
]

// ── 404 page ───────────────────────────────────────
.notfound [
  text-align = center
  padding = 2.5r 0
]

.notfound__code [
  font-size = 5r
  line-height = 1
  font-weight = 300
  color = accent
  margin-bottom = 1r
]

.notfound__lead [
  font-size = 1.2r
  color = muted
  margin-top = 0
]

// ── Features page ──────────────────────────────────
.card-grid [
  display = grid
  grid-template-columns = repeat(auto-fill, minmax(280px, 1fr))
  gap = 1.5r
  margin-top = 2r
]

.card [
  padding = 1.25r
  border = 1px solid borderColor
  border-radius = 4px
]

.card h3 [
  font-size = 1.15r
  margin-top = 0
]

.card p [
  font-size = 0.95r
  color = rgba(41, 41, 41, 0.7)
  margin-top = 0.5r
]

// ── Demo sections ──────────────────────────────────
.demo-section [
  margin-top = 3r
  padding-top = 2r
  border-top = 1px solid borderColor
]

.demo-section h2 [
  margin-top = 0
]

.btn [
  display = inline-block
  padding = 0.6r 1.2r
  background = accent
  color = #fff
  border-radius = 4px
  text-decoration = none
  font-size = 0.95r
  cursor = pointer
  border = none
  &:hover [
    background = darken(accent, 10%)
    color = #fff
  ]
]

.code-block [
  background = #f8f8f8
  padding = 1r
  border-radius = 4px
  font-family = ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size = 0.9r
  overflow-x = auto
  margin-top = 1r
]

// ── Tags page ──────────────────────────────────────
.tag-badge [
  display = inline-block
  padding = 0.2r 0.6r
  margin = 0.2r
  background = codeBg
  border-radius = 3px
  font-size = 0.85r
  color = accent
  text-decoration = none
  &:hover [
    background = accent
    color = #fff
  ]
]

// ── Breadcrumb ─────────────────────────────────────
.breadcrumb [
  display = flex
  gap = 0.5r
  font-size = 0.9r
  color = muted
  margin-bottom = 1r
  align-items = center
]

.breadcrumb a [
  color = muted
  text-decoration = none
  &:hover [
    color = accent
  ]
]

// ── Progress bar ───────────────────────────────────
.progress [
  width = 100%
  height = 8px
  background = borderColor
  border-radius = 4px
  margin-top = 0.75r
  overflow = hidden
]

.progress__fill [
  height = 100%
  background = accent
  border-radius = 4px
  transition = width 0.3s ease
]

// ── Utility ────────────────────────────────────────
.visually-hidden [
  clip = rect(1px, 1px, 1px, 1px)
  height = 1px
  overflow = hidden
  position = absolute
  white-space = nowrap
  width = 1px
]

// ── Responsive ─────────────────────────────────────
@media (max-width: 640px) [
  html [ font-size = 16px ]
  .site-header__inner [
    flex-direction = column
    gap = 0.5r
    text-align = center
  ]
  .site-nav [
    flex-wrap = wrap
    justify-content = center
  ]
  .hero__title [ font-size = 2.25r ]
  .hero__lead [ font-size = 1.2r ]
  .post__pagination [
    flex-direction = column
    gap = 1r
    align-items = flex-start
  ]
  .card-grid [
    grid-template-columns = 1fr
  ]
]
