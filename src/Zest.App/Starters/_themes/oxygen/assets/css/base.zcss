// base.zcss
//
// Reset, global element styles, typography, the layout shell (header, main,
// footer) — the skeleton every page shares.
//
// Dependencies: tokens.zcss

@use "tokens.zcss";

// ── Reset & base ─────────────────────────────────────────────

html [
  box-sizing: border-box;
  scroll-behavior: smooth;
  height: 100%;
]

*, *:before, *:after [
  box-sizing: inherit;
  border-style: solid;
  border-width: 0;
  border-color: currentColor;
  margin: 0;
  padding: 0;
]

body [
  height: 100%;
  background: background;
  color: ink;
  font-family: font-sans;
  font-size: text-lg;
  line-height: 1.54;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: 'liga', 'tnum', 'case', 'calt', 'zero', 'ss01', 'locl';
  font-variant-ligatures: contextual;
]

::selection [
  background: accent;
  color: background;
]

img [
  display: block;
  max-width: 100%;
  height: auto;
  margin-top: 1rem;
]

a [
  text-decoration: none;
  color: inherit;
  transition: all 200ms linear;
]

a:hover [
  color: accent;
]

b, strong [
  font-weight: 500;
]

ul, ol [
  list-style-position: outside;
  padding-left: 1.5rem;
  margin-top: 1rem;
]

ul [
  list-style-type: square;
]

blockquote [
  margin-top: 1rem;
  margin-bottom: 1rem;
  padding-left: 1rem;
  border-left: 3px solid accent;
  font-style: italic;
  color: ink-80;
]

table [
  border-collapse: collapse;
  caption-side: bottom;
  overflow-x: auto;
  min-width: 100%;
  border: 1px solid ink-30;
  margin-top: 1rem;
]

td, th [
  border: 1px solid ink-30;
  padding: 0.5rem;
  text-align: left;
]

th [
  font-weight: 500;
]

hr [
  width: 100%;
  border: none;
  background: ink-10;
  height: 1px;
  margin-top: 2rem;
]

pre [
  white-space: pre-wrap;
  tab-size: 2;
  font-size: 0.95rem;
  border: 1px solid ink-10;
  padding: 1rem;
  margin-top: 1rem;
  overflow: auto;
  font-family: font-mono;
  line-height: 1.6;
]

code, kbd [
  color: accent;
  font-family: font-mono;
  background: ink-30;
  padding: 1px 6px;
  margin: 0 2px;
  font-size: 0.95rem;
]

pre code [
  background: transparent;
  padding: 0;
  margin: 0;
]

mark [
  background: accent;
  color: background;
  padding: 1px 6px;
  margin: 0 2px;
  font-size: 0.95rem;
]

:focus-visible [
  outline: 2px solid accent;
  outline-offset: 2px;
]

// ── Typography ───────────────────────────────────────────────

h1, h2, h3, h4, h5, h6 [
  line-height: 1.3;
  font-weight: 400;
  color: ink;
]

h1 [ font-size: text-4xl; ]
h2 [ font-size: text-3xl; ]
h3 [ font-size: text-2xl; ]
h4 [ font-size: text-xl; ]
h5 [ font-size: text-lg; ]

* + h1, * + h2 [
  margin-top: 5rem;
]

* + h3, * + h4, * + h5 [
  margin-top: 3rem;
]

* + p [
  margin-top: 2rem;
]

h2 + p, h3 + p, h4 + p [
  margin-top: 1rem;
]

// ── Layout wrapper ───────────────────────────────────────────

.layout-wrapper [
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-height: 100vh;
]

.main [
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 48.75rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
  padding-bottom: 4rem;
]

// ── Header ───────────────────────────────────────────────────

.header [
  width: 100%;
  text-transform: uppercase;
  margin-bottom: 4rem;
]

.header__content [
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  margin: 1rem auto 0;
  max-width: 48.75rem;
  padding: 0 1rem 1rem;
  border-bottom: 1px solid ink-10;
]

.site-title [
  font-size: text-xl;
  margin: 1rem 0;
  font-weight: 500;
]

.site-title a [
  color: ink;
  text-decoration: none;
]

.site-title a:hover [
  color: accent;
]

.nav__list [
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  font-size: text-base;
  padding: 0.5rem 0;
  margin: 0;
]

.nav__list li [
  margin-right: 2rem;
]

.nav__list li:last-child [
  margin-right: 0;
]

.nav__list a [
  color: ink-80;
  text-decoration: none;
  margin: 1rem 0;
]

.nav__list a:hover, .nav__list a[aria-current="page"] [
  color: ink;
  text-decoration: underline;
]

// ── Footer ───────────────────────────────────────────────────

.footer [
  padding-left: 1rem;
  padding-right: 1rem;
  padding-bottom: 4rem;
  width: 100%;
]

.footer__content [
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: auto;
  margin-right: auto;
  max-width: 48.75rem;
  width: 100%;
  font-size: text-base;
  border-top: 1px solid ink-10;
]

.footer__content > * [
  margin-top: 2rem;
]

.footer__links [
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  margin: 2rem 0 0;
  padding-left: 0;
  font-size: text-sm;
]

.footer__links li [
  margin-right: 2rem;
]

.footer__links li:last-child [
  margin-right: 0;
]

.footer__links a [
  color: ink-80;
  text-decoration: none;
]

.footer__links a:hover [
  color: accent;
]

.footer__attribution [
  font-size: text-sm;
  color: ink-80;
]
