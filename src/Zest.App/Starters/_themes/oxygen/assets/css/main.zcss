// ─────────────────────────────────────────────────────────────
// oxygen — a quiet, minimal blog theme for Zest, restyled after
// the Eleventy Duo design: pure paper background, ink text, one
// accent, uppercase navigation, and roomy editorial typography.
//
// ZCSS keeps an F# flavor: rule bodies use `[ ]` blocks and
// variables are declared with `let`. Colors are CSS custom
// properties with fallbacks so users can override them from
// _config.toml [params.colors] without editing the theme.
// ─────────────────────────────────────────────────────────────

// `ink` mirrors CSS `--color`: the bare name `color` is a CSS keyword, so a
// `let color = ...` binding would never be substituted by the ZCSS resolver.
let accent      = var(--accent, #0074d9)
let background  = var(--background, #fffffe)
let ink         = var(--color, #292929)
let ink-80      = var(--color-80, rgba(41, 41, 41, .8))
let ink-30      = var(--color-30, rgba(41, 41, 41, .3))
let ink-10      = var(--color-10, rgba(41, 41, 41, .1))

let text-xs  = 0.75rem
let text-sm  = 0.875rem
let text-base = 1rem
let text-lg  = 1.125rem
let text-xl  = 1.25rem
let text-2xl = 1.5rem
let text-3xl = 1.875rem
let text-4xl = 2.25rem
let text-5xl = 3rem

let font-sans = 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif
let font-mono = 'Inconsolata', 'SF Mono', 'Cascadia Code', Consolas, monospace

// ── Reset & base ─────────────────────────────────────────────

html [
  box-sizing: border-box;
  scroll-behavior: smooth;
  height: 100%;
]

*, *:before, *:after [
  box-sizing: inherit;
  border-style: solid;
  border-width: 0;
  border-color: currentColor;
  margin: 0;
  padding: 0;
]

body [
  height: 100%;
  background: background;
  color: ink;
  font-family: font-sans;
  font-size: text-lg;
  line-height: 1.54;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: 'liga', 'tnum', 'case', 'calt', 'zero', 'ss01', 'locl';
  font-variant-ligatures: contextual;
]

::selection [
  background: accent;
  color: background;
]

img [
  display: block;
  max-width: 100%;
  height: auto;
  margin-top: 1rem;
]

a [
  text-decoration: none;
  color: inherit;
  transition: all 200ms linear;
]

a:hover [
  color: accent;
]

b, strong [
  font-weight: 500;
]

ul, ol [
  list-style-position: outside;
  padding-left: 1.5rem;
  margin-top: 1rem;
]

ul [
  list-style-type: square;
]

blockquote [
  margin-top: 1rem;
  margin-bottom: 1rem;
  padding-left: 1rem;
  border-left: 3px solid accent;
  font-style: italic;
  color: ink-80;
]

table [
  border-collapse: collapse;
  caption-side: bottom;
  overflow-x: auto;
  min-width: 100%;
  border: 1px solid ink-30;
  margin-top: 1rem;
]

td, th [
  border: 1px solid ink-30;
  padding: 0.5rem;
  text-align: left;
]

th [
  font-weight: 500;
]

hr [
  width: 100%;
  border: none;
  background: ink-10;
  height: 1px;
  margin-top: 2rem;
]

pre [
  white-space: pre-wrap;
  tab-size: 2;
  font-size: 0.95rem;
  border: 1px solid ink-10;
  padding: 1rem;
  margin-top: 1rem;
  overflow: auto;
  font-family: font-mono;
  line-height: 1.6;
]

code, kbd [
  color: accent;
  font-family: font-mono;
  background: ink-30;
  padding: 1px 6px;
  margin: 0 2px;
  font-size: 0.95rem;
]

pre code [
  background: transparent;
  padding: 0;
  margin: 0;
]

mark [
  background: accent;
  color: background;
  padding: 1px 6px;
  margin: 0 2px;
  font-size: 0.95rem;
]

:focus-visible [
  outline: 2px solid accent;
  outline-offset: 2px;
]

// ── Typography ───────────────────────────────────────────────

h1, h2, h3, h4, h5, h6 [
  line-height: 1.3;
  font-weight: 400;
  color: ink;
]

h1 [ font-size: text-4xl; ]
h2 [ font-size: text-3xl; ]
h3 [ font-size: text-2xl; ]
h4 [ font-size: text-xl; ]
h5 [ font-size: text-lg; ]

* + h1, * + h2 [
  margin-top: 5rem;
]

* + h3, * + h4, * + h5 [
  margin-top: 3rem;
]

* + p [
  margin-top: 2rem;
]

h2 + p, h3 + p, h4 + p [
  margin-top: 1rem;
]

// ── Layout wrapper ───────────────────────────────────────────

.layout-wrapper [
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-height: 100vh;
]

.main [
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 48.75rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
  padding-bottom: 4rem;
]

// ── Header ───────────────────────────────────────────────────

.header [
  width: 100%;
  text-transform: uppercase;
  margin-bottom: 4rem;
]

.header__content [
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  margin: 1rem auto 0;
  max-width: 48.75rem;
  padding: 0 1rem 1rem;
  border-bottom: 1px solid ink-10;
]

.site-title [
  font-size: text-xl;
  margin: 1rem 0;
  font-weight: 500;
]

.site-title a [
  color: ink;
  text-decoration: none;
]

.site-title a:hover [
  color: accent;
]

.nav__list [
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  font-size: text-base;
  padding: 0.5rem 0;
  margin: 0;
]

.nav__list li [
  margin-right: 2rem;
]

.nav__list li:last-child [
  margin-right: 0;
]

.nav__list a [
  color: ink-80;
  text-decoration: none;
  margin: 1rem 0;
]

.nav__list a:hover, .nav__list a[aria-current="page"] [
  color: ink;
  text-decoration: underline;
]

// ── Hero (home) ──────────────────────────────────────────────

.hero [
  display: flex;
  flex-direction: column;
  margin-top: 3rem;
]

.hero h1 [
  font-size: text-5xl;
  line-height: 1.15;
]

.hero p [
  font-size: text-2xl;
  margin-top: 1rem;
  color: ink-80;
  max-width: 36rem;
]

.hero__social-links [
  display: flex;
  flex-wrap: wrap;
  list-style-type: none;
  margin-top: 2rem;
  padding-left: 0;
  text-transform: uppercase;
  font-size: text-sm;
]

.hero__social-links > li [
  margin-right: 2rem;
  margin-top: 1rem;
]

.hero__social-links a [
  color: ink-80;
  text-decoration: none;
]

.hero__social-links a:hover [
  color: accent;
]

// ── Post list (home / tags) ─────────────────────────────────

.post-list__wrapper [
  margin-top: 6rem;
]

.post-list__heading [
  font-size: text-3xl;
  margin-bottom: 1rem;
]

.post-list [
  list-style: none;
  padding-left: 0;
  margin-top: 0;
]

.post-list__item [
  display: flex;
  flex-direction: column;
  padding-top: 3rem;
  padding-bottom: 3rem;
  border-top: 1px solid ink-10;
]

.post-list__item:last-child [
  border-bottom: 1px solid ink-10;
]

.post-list__meta [
  font-size: text-sm;
  color: ink-80;
]

.post-list__meta > * + * [
  margin-left: 1rem;
]

.post-list__title [
  font-size: text-2xl;
  margin-top: 0.5rem;
]

.post-list__title a [
  color: ink;
  text-decoration: none;
]

.post-list__title a:hover [
  color: accent;
  text-decoration: underline;
]

.post-list__tags [
  font-size: text-sm;
  margin-top: 0.5rem;
]

.post-list__tags a [
  color: ink-80;
  text-decoration: none;
  margin-right: 1rem;
]

.post-list__tags a:hover [
  color: accent;
]

.post-list__excerpt [
  margin-top: 1rem;
  color: ink-80;
  max-width: 40rem;
]

.post-list__read-more [
  width: fit-content;
  font-size: text-base;
  text-transform: capitalize;
  margin-top: 1rem;
  text-decoration: underline;
  color: ink;
]

.post-list__read-more:hover [
  color: accent;
]

// ── Single post ──────────────────────────────────────────────

.post [
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 3rem;
]

.post > * + * [
  margin-top: 4rem;
]

.post__header h1 [
  line-height: 1.25;
]

.post__details [
  opacity: 0.6;
  font-size: 0.9rem;
  margin-top: 1rem;
]

.post__details > * + * [
  margin-left: 0.5rem;
]

.post__content [
  word-wrap: break-word;
  min-width: 0;
]

.post__aside [
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid ink-10;
]

.post__tags [
  opacity: 0.8;
  font-size: text-sm;
]

.post__tags a [
  margin-right: 0.5rem;
  color: ink-80;
  text-decoration: none;
]

.post__tags a:hover [
  color: accent;
]

.post__pagination [
  margin-top: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
]

.post__pagination a [
  display: flex;
  align-items: center;
  color: ink-80;
  text-decoration: none;
  max-width: 48%;
]

.post__pagination a:hover [
  color: accent;
]

.post__pagination span [
  padding-left: 0.5rem;
  padding-right: 0.5rem;
]

.post__pagination > *:only-child [
  margin-left: auto;
  margin-right: auto;
]

// ── Tags index & taxonomy ───────────────────────────────────

.tags [
  margin-top: 2rem;
  margin-bottom: 2rem;
  font-size: text-sm;
]

.tags .post-tag [
  margin-right: 1rem;
  color: ink-80;
  text-decoration: none;
]

.tags .post-tag:hover [
  color: accent;
]

// ── Footer ───────────────────────────────────────────────────

.footer [
  padding-left: 1rem;
  padding-right: 1rem;
  padding-bottom: 4rem;
  width: 100%;
]

.footer__content [
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: auto;
  margin-right: auto;
  max-width: 48.75rem;
  width: 100%;
  font-size: text-base;
  border-top: 1px solid ink-10;
]

.footer__content > * [
  margin-top: 2rem;
]

.footer__links [
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  margin: 2rem 0 0;
  padding-left: 0;
  font-size: text-sm;
]

.footer__links li [
  margin-right: 2rem;
]

.footer__links li:last-child [
  margin-right: 0;
]

.footer__links a [
  color: ink-80;
  text-decoration: none;
]

.footer__links a:hover [
  color: accent;
]

.footer__attribution [
  font-size: text-sm;
  color: ink-80;
]

// ── 404 ──────────────────────────────────────────────────────

.not-found [
  text-align: center;
  padding: 6rem 0;
]

.not-found h1 [
  font-size: 5rem;
  color: accent;
  letter-spacing: 0.05em;
]

.not-found p [
  font-size: text-xl;
  color: ink-80;
  margin-top: 1rem;
]

// ── DSL components (features demo) ───────────────────────────

.grid [
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  gap: 1.5rem;
  padding-left: 0;
]

.card [
  background: background;
  border: 1px solid ink-10;
  padding: 1.6rem;
]

.card h4 [
  font-size: text-xl;
  margin: 0 0 0.5rem;
]

.card p [
  color: ink-80;
  font-size: 0.95rem;
  margin: 0 0 1.1rem;
]

.btn [
  display: inline-block;
  padding: 0.5rem 1.1rem;
  border: 1px solid accent;
  color: accent;
  background: transparent;
  font-size: 0.95rem;
  text-decoration: none;
  cursor: pointer;
]

.btn:hover [
  background: accent;
  color: background;
]

.tag, .badge [
  display: inline-block;
  font-size: 0.78rem;
  padding: 0.2rem 0.65rem;
  border: 1px solid ink-10;
  color: ink-80;
  text-decoration: none;
  margin-right: 0.5rem;
]

a.tag:hover, a.badge:hover [
  color: accent;
  border-color: accent;
]

.breadcrumb [
  font-size: 0.9rem;
  color: ink-80;
]

.breadcrumb ol [
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding-left: 0;
]

.breadcrumb li + li::before [
  content: "·";
  margin-right: 0.5rem;
  color: ink-30;
]

.breadcrumb li.active [
  color: ink;
]

.progress-wrapper [
  margin: 1rem 0;
]

.progress-label [
  display: block;
  font-size: 0.85rem;
  color: ink-80;
  margin-bottom: 0.4rem;
]

progress [
  width: 100%;
  height: 0.5rem;
  border: 1px solid ink-10;
  background: background;
]

progress::-webkit-progress-bar [
  background: background;
]

progress::-webkit-progress-value [
  background: accent;
]

progress::-moz-progress-bar [
  background: accent;
]

.alert [
  padding: 0.85rem 1.1rem;
  border: 1px solid ink-10;
  border-left: 3px solid accent;
  margin: 1.25rem 0;
  font-size: 0.95rem;
]

.icon [
  font-size: 1.15em;
  line-height: 1;
]

// ── Responsive ───────────────────────────────────────────────

@media (max-width: 640px) [
  .hero h1 [
    font-size: text-4xl;
  ]

  .post__header h1 [
    font-size: text-3xl;
  ]

  .header__content [
    flex-direction: column;
    align-items: flex-start;
  ]

  .nav__list [
    flex-wrap: wrap;
  ]

  .post__pagination [
    flex-direction: column;
    align-items: flex-start;
  ]

  .post__pagination a [
    max-width: 100%;
  ]

  .post__pagination > *:only-child [
    margin-left: 0;
    margin-right: 0;
  ]
]

// ── Print ────────────────────────────────────────────────────

@media print [
  .header, .footer, .post__aside, .post__pagination [
    display: none;
  ]

  body [
    background: #ffffff;
    color: #000000;
    font-size: 12pt;
  ]
]
